# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs.
# Ne partagez jamais votre .env réel (mots de passe et clés API).

PORT=3000

# Domaine où sera hébergé le site (ex: https://ncrea.studio). Mettre "*" en développement local uniquement.
ALLOWED_ORIGIN=*

# Où envoyer les demandes reçues
RECIPIENT_EMAIL=otsemstudio@gmail.com
RECIPIENT_PHONE=250799496971

# --- Email : compte Gmail qui ENVOIE les notifications ---
# 1. Utilisez de préférence un compte Gmail dédié (ex: otsemstudio@gmail.com lui-même, ou un autre).
# 2. Activez la validation en 2 étapes sur ce compte Google.
# 3. Créez un "mot de passe d'application" ici : https://myaccount.google.com/apppasswords
# 4. Collez ce mot de passe (16 caractères, sans espaces) ci-dessous — PAS votre mot de passe Gmail normal.
GMAIL_USER=otsemstudio@gmail.com
GMAIL_APP_PASSWORD=MarieEsther2ndC3

# --- SMS : Africa's Talking ---
# 1. Créez un compte sur https://account.africastalking.com
# 2. Récupérez votre nom d'utilisateur (username) et votre clé API (API key) dans le tableau de bord.
# 3. Rechargez votre compte en crédit SMS (le sandbox gratuit permet de tester avec un numéro vérifié).
AT_USERNAME=sandbox
AT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
