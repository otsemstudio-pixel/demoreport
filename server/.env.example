# Copiez ce fichier en ".env" et remplissez avec vos vraies valeurs.
# Ne partagez jamais votre .env réel (mots de passe et clés API).

PORT=3000

# Domaine où sera hébergé le site (ex: https://ncrea.studio). Mettre "*" en développement local uniquement.
ALLOWED_ORIGIN=*

# Où envoyer les demandes reçues
RECIPIENT_EMAIL=otsemstudio@gmail.com
RECIPIENT_PHONE=250799496971

# --- Email : Brevo (API HTTPS — fonctionne même sur hébergement gratuit) ---
# 1. Créez un compte gratuit sur https://www.brevo.com
# 2. "Senders, Domains & Dedicated IPs" → "Senders" → ajoutez otsemstudio@gmail.com et vérifiez-le.
# 3. "SMTP & API" → "API Keys" → générez une clé.
BREVO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=otsemstudio@gmail.com

# --- Portfolio de projets (Supabase) ---
# 1. Créez un compte gratuit sur https://supabase.com → "New project".
# 2. Une fois le projet créé : Project Settings → API → copiez "Project URL" et la clé
#    "service_role" (PAS la clé "anon" — celle-ci a tous les droits, gardez-la secrète).
# 3. SQL Editor → collez le contenu de server/supabase-schema.sql → Run.
# 4. Storage → New bucket → nom exact "project-images" → cochez "Public bucket" → Create.
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Panneau admin (admin.html) ---
# Choisissez vous-même un mot de passe fort. C'est lui que vous taperez sur admin.html.
ADMIN_PASSWORD=changez-moi-en-un-mot-de-passe-fort
# Optionnel : laissez vide pour qu'un token aléatoire soit généré à chaque démarrage du
# serveur (suffisant pour un usage personnel). Ne renseignez que si vous voulez un token fixe.
ADMIN_TOKEN=

# --- SMS : Africa's Talking ---
# 1. Créez un compte sur https://account.africastalking.com
# 2. Récupérez votre nom d'utilisateur (username) et votre clé API (API key) dans le tableau de bord.
# 3. Rechargez votre compte en crédit SMS (le sandbox gratuit permet de tester avec un numéro vérifié).
AT_USERNAME=sandbox
AT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
